############################################################
# 4. STOCK ET LOGISTIQUE
############################################################

### Quantités disponibles (Stock Available)
GET {{baseUrl}}/api/stock_availables?display=[id,id_product,id_product_attribute,quantity]
Authorization: Basic {{wsKey}} :

### Modifier le stock (ex: ID 1)
# PUT: C'est l'endpoint principal pour mettre à jour les quantités. 
# 'id', 'id_product', 'id_product_attribute' et 'quantity' sont nécessaires.
# Note: L'id_shop est souvent requis en mode multi-boutique.
PUT {{baseUrl}}/api/stock_availables/1
Authorization: Basic {{wsKey}} :
Content-Type: text/xml

<prestashop>
  <stock_available>
    <id>1</id>
    <id_product>1</id_product>
    <id_product_attribute>0</id_product_attribute>
    <quantity>100</quantity>
    <depends_on_stock>0</depends_on_stock>
    <out_of_stock>2</out_of_stock>
  </stock_available>
</prestashop>

### Stocks (Inventaire réel)
GET {{baseUrl}}/api/stocks?display=[id,id_product,id_product_attribute,physical_quantity,usable_quantity]
Authorization: Basic {{wsKey}} :

