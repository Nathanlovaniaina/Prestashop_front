### Configuration
@baseUrl = http://localhost/prestashop
@wsKey = kqZubkmM41ZZ0X0oWO1LNhhW86kz84k4
@clientId = YOUR_CLIENT_ID_HERE
@clientSecret = YOUR_CLIENT_SECRET_HERE
@accessToken = YOUR_ACCESS_TOKEN_HERE

# Note: Le format par défaut est le XML
# Note: L'authentification se fait via Authorization: Basic {{wsKey}} :
# Note: Pour le POST/PUT, utiliser Content-Type: text/xml

############################################################
# 1. CATALOGUE PRODUITS (Complet)
############################################################

### Liste tous les produits
GET {{baseUrl}}/api/products?display=[id,name,price,active]
Authorization: Basic {{wsKey}} :

### Détail d'un produit (ex: ID 1)
GET {{baseUrl}}/api/products/20
Authorization: Basic {{wsKey}} :

### Schémas de création (Synopsis et Blanc)
GET {{baseUrl}}/api/products?schema=synopsis
Authorization: Basic {{wsKey}} :

GET {{baseUrl}}/api/products?schema=blank
Authorization: Basic {{wsKey}} :

### Ajouter un nouveau produit
# POST: Envoyer un XML encapsulé dans <prestashop><product>...</product></prestashop>.
# Les champs obligatoires sont 'name', 'link_rewrite' et 'id_category_default'.
# Utilisez ?schema=blank pour obtenir un modèle XML vide complet.
POST {{baseUrl}}/api/products
Authorization: Basic {{wsKey}} :
Content-Type: text/xml

<prestashop>
  <product>
    <name><language id="1">Nouveau Produit</language></name>
    <link_rewrite><language id="1">nouveau-produit</language></link_rewrite>
    <id_category_default>2</id_category_default>
    <price>19.90</price>
    <active>1</active>
  </product>
</prestashop>

### Modifier un produit (ex: ID 1)
# PUT: Envoyer le XML complet incluant l'ID de la ressource.
# Il est fortement recommandé de faire un GET, de modifier le XML reçu, puis de le renvoyer.
# Note: L'ID dans le XML doit correspondre à l'ID dans l'URL.
PUT {{baseUrl}}/api/products/20
Authorization: Basic {{wsKey}} :
Content-Type: text/xml

<prestashop>
  <product>
    <id>20</id>
    <price>25.00</price>
    <active>1</active>
  </product>
</prestashop>

### Gestion de l'arborescence des catégories
GET {{baseUrl}}/api/categories?display=[id,name,active]
Authorization: Basic {{wsKey}} :

### Ajouter une catégorie
# POST: Requiert 'name', 'link_rewrite' et 'active'.
POST {{baseUrl}}/api/categories
Authorization: Basic {{wsKey}} :
Content-Type: text/xml

<prestashop>
  <category>
    <name><language id="1">Nouvelle Catégorie</language></name>
    <link_rewrite><language id="1">nouvelle-categorie</language></link_rewrite>
    <active>1</active>
    <id_parent>2</id_parent>
  </category>
</prestashop>

### Modifier une catégorie (ex: ID 3)
# PUT: Permet de changer le parent ou le nom d'une catégorie existante.
PUT {{baseUrl}}/api/categories/3
Authorization: Basic {{wsKey}} :
Content-Type: text/xml

<prestashop>
  <category>
    <id>3</id>
    <name><language id="1">Nom Catégorie Modifié</language></name>
  </category>
</prestashop>

### Gestion des déclinaisons (combinations)
GET {{baseUrl}}/api/combinations?display=[id,id_product,reference]
Authorization: Basic {{wsKey}} :

### Ajouter une déclinaison (ex: pour le produit ID 1)
# POST: Relie un produit à un ensemble d'attributs. Nécessite 'id_product'.
POST {{baseUrl}}/api/combinations
Authorization: Basic {{wsKey}} :
Content-Type: text/xml

<prestashop>
  <combination>
    <id_product>1</id_product>
    <reference>REF-COL-XL</reference>
    <price>2.00</price>
    <quantity>50</quantity>
    <associations>
      <product_option_values>
        <product_option_value><id>1</id></product_option_value>
      </product_option_values>
    </associations>
  </combination>
</prestashop>

### Options de produits (Groupes d'attributs)
GET {{baseUrl}}/api/product_options?display=[id,name,public_name]
Authorization: Basic {{wsKey}} :

### Ajouter une option (ex: Taille)
# POST: Requiert 'name' et 'public_name' (multilingue).
POST {{baseUrl}}/api/product_options
Authorization: Basic {{wsKey}} :
Content-Type: text/xml

<prestashop>
  <product_option>
    <name><language id="1">Taille</language></name>
    <public_name><language id="1">Taille</language></public_name>
    <group_type>select</group_type>
  </product_option>
</prestashop>

### Valeurs des options de produits (Attributs)
GET {{baseUrl}}/api/product_option_values?display=[id,id_attribute_group,name]
Authorization: Basic {{wsKey}} :

### Ajouter une valeur d'option (ex: XL)
# POST: Requiert 'id_attribute_group' (ID de l'option) et 'name'.
POST {{baseUrl}}/api/product_option_values
Authorization: Basic {{wsKey}} :
Content-Type: text/xml

<prestashop>
  <product_option_value>
    <id_attribute_group>1</id_attribute_group>
    <name><language id="1">XL</language></name>
  </product_option_value>
</prestashop>

### Caractéristiques des produits (Features)
GET {{baseUrl}}/api/product_features?display=[id,name]
Authorization: Basic {{wsKey}} :

### Valeurs des caractéristiques (Feature Values)
GET {{baseUrl}}/api/product_feature_values?display=[id,id_feature,value]
Authorization: Basic {{wsKey}} :

### Pièces jointes des produits
GET {{baseUrl}}/api/attachments
Authorization: Basic {{wsKey}} :

### Champs de personnalisation
GET {{baseUrl}}/api/product_customization_fields
Authorization: Basic {{wsKey}} :

### Personnalisations
GET {{baseUrl}}/api/customizations
Authorization: Basic {{wsKey}} :

### Tags produits
GET {{baseUrl}}/api/tags?display=[id,name]
Authorization: Basic {{wsKey}} :

### Images (Gestion spécifique)
GET {{baseUrl}}/api/images/products/1
Authorization: Basic {{wsKey}} :

