Authorization: Basic {{wsKey}} :

### Paniers (Carts)
GET {{baseUrl}}/api/carts?display=[id,id_customer,id_currency,date_add,date_upd]
Authorization: Basic {{wsKey}} :

### Créer un panier
# POST: Permet de préparer une commande. Requiert 'id_customer', 'id_currency' et 'id_lang'.
POST {{baseUrl}}/api/carts
Authorization: Basic {{wsKey}} :
Content-Type: text/xml

<prestashop>
  <cart>
    <id_customer>1</id_customer>
    <id_currency>1</id_currency>
    <id_lang>1</id_lang>
    <associations>
      <cart_rows>
        <cart_row>
          <id_product>1</id_product>
          <quantity>2</quantity>
        </cart_row>
      </cart_rows>
    </associations>
  </cart>
</prestashop>

### Règles de panier (Vouchers)
GET {{baseUrl}}/api/cart_rules?display=[id,name,code,active]
Authorization: Basic {{wsKey}} :

############################################################
# 3. CLIENTS ET MESSAGERIE
############################################################

### Clients
GET {{baseUrl}}/api/customers?display=[id,lastname,firstname,email,active]
Authorization: Basic {{wsKey}} :

### Créer un client
# POST: 'lastname', 'firstname', 'email' et 'passwd' (hashé ou clair selon config) sont requis.
POST {{baseUrl}}/api/customers
Authorization: Basic {{wsKey}} :
Content-Type: text/xml

<prestashop>
  <customer>
    <lastname>Dupont</lastname>
    <firstname>Jean</firstname>
    <email>jean.dupont@example.com</email>
    <passwd>motdepasse123</passwd>
    <active>1</active>
  </customer>
</prestashop>

### Modifier un client (ex: ID 1)
# PUT: Pour changer l'email ou le statut d'un client.
PUT {{baseUrl}}/api/customers/1
Authorization: Basic {{wsKey}} :
Content-Type: text/xml

<prestashop>
  <customer>
    <id>1</id>
    <email>nouveau.email@example.com</email>
  </customer>
</prestashop>

### Adresses
GET {{baseUrl}}/api/addresses?display=[id,alias,lastname,firstname,city,postcode,id_country]
Authorization: Basic {{wsKey}} :

### Ajouter une adresse
# POST: Requiert 'id_customer' (ou id_manufacturer/supplier), 'alias', 'lastname', 'firstname', 'address1', 'city', 'postcode', 'id_country'.
POST {{baseUrl}}/api/addresses
Authorization: Basic {{wsKey}} :
Content-Type: text/xml

<prestashop>
  <address>
    <id_customer>1</id_customer>
    <alias>Ma Maison</alias>
    <lastname>Dupont</lastname>
    <firstname>Jean</firstname>
    <address1>123 Rue de la Paix</address1>
    <city>Paris</city>
    <postcode>75001</postcode>
    <id_country>8</id_country>
  </address>
</prestashop>

### Groupes de clients
GET {{baseUrl}}/api/groups?display=[id,name]
Authorization: Basic {{wsKey}} :

