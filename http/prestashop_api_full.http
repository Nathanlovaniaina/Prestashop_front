### Configuration
@baseUrl = http://localhost/prestashop
@wsKey = kqZubkmM41ZZ0X0oWO1LNhhW86kz84k4

# Note: Le format par défaut est XML. Ajoutez ?output_format=JSON pour du JSON.
# Note: L'authentification se fait via Authorization: Basic {{wsKey}} : (le colon est important)

############################################################
# 1. PARAMÈTRES GLOBAUX DE L'API
############################################################

### Liste de toutes les ressources disponibles
# Permet de voir quels terminaux sont activés pour votre clé API.
GET {{baseUrl}}/api/
Authorization: Basic {{wsKey}} :

### Paramètre : display
# 'full' pour tous les champs, ou une liste [champ1,champ2]
GET {{baseUrl}}/api/products?display=[id,name,price]
Authorization: Basic {{wsKey}} :

### Paramètre : filter
# Filtrer par valeur exacte ou intervalle
GET {{baseUrl}}/api/products?filter[id]=[1|5]&filter[active]=1
Authorization: Basic {{wsKey}} :

### Paramètre : sort
# Trier par un ou plusieurs champs (ASC ou DESC)
GET {{baseUrl}}/api/products?sort=[price_DESC,id_ASC]
Authorization: Basic {{wsKey}} :

### Paramètre : limit
# Pagination : limit=nombre ou limit=début,nombre
GET {{baseUrl}}/api/products?limit=5,10
Authorization: Basic {{wsKey}} :

### Paramètre : schema
# synopsis : description technique des champs
# blank : modèle XML vide pour POST/PUT
GET {{baseUrl}}/api/products?schema=synopsis
Authorization: Basic {{wsKey}} :

### Paramètre : output_format
# Forcer le format de sortie (JSON ou XML)
GET {{baseUrl}}/api/products?output_format=JSON
Authorization: Basic {{wsKey}} :

